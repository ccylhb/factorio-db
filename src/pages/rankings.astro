---
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import items from "../data/factorio_items.json";

const withRecipe = items.filter((x) => x.time && (x.ingredients || []).length > 0);
const fastest = withRecipe.slice().sort((a, b) => a.time - b.time).slice(0, 12);
const slowest = withRecipe.slice().sort((a, b) => b.time - a.time).slice(0, 10);
const mostInputs = withRecipe
  .slice()
  .sort((a, b) => b.ingredients.length - a.ingredients.length)
  .slice(0, 10);
const heavyStack = items
  .filter((x) => x.stack_size)
  .sort((a, b) => b.stack_size - a.stack_size)
  .slice(0, 10);

---
<Base
  title="Factorio Rankings — fastest recipes, most complex & biggest stacks"
  description="Factorio leaderboards: fastest crafting recipes, slowest recipes, most complex ingredient lists and biggest stack sizes."
>
  <h1>Rankings</h1>
  <p class="muted">Leaderboards computed from full recipe data. Click any entry for details.</p>

  <div class="grid grid-2" style="margin:1.25rem 0">
    <div class="card">
      <h2 style="margin-top:0">⚡ Fastest recipes</h2>
      <ol class="rank-list">
        {fastest.map((x) => (
          <li>
            <a href={`/items/${x.slug}/`}>{x.title}</a>
            {x.icon_file && <img src={`/icons/${x.icon_file}`} alt="" width="20" height="20" style="vertical-align:middle" loading="lazy" />}
            <span class="muted"> — {x.time}s ({Math.round((60 / x.time) * 10) / 10}/min)</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="card">
      <h2 style="margin-top:0">🐢 Slowest recipes</h2>
      <ol class="rank-list">
        {slowest.map((x) => (
          <li>
            <a href={`/items/${x.slug}/`}>{x.title}</a>
            <span class="muted"> — {x.time}s</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="card">
      <h2 style="margin-top:0">🧩 Most ingredients</h2>
      <ol class="rank-list">
        {mostInputs.map((x) => (
          <li>
            <a href={`/items/${x.slug}/`}>{x.title}</a>
            <span class="muted"> — {x.ingredients.length} inputs</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="card">
      <h2 style="margin-top:0">📦 Biggest stacks</h2>
      <ol class="rank-list">
        {heavyStack.map((x) => (
          <li>
            <a href={`/items/${x.slug}/`}>{x.title}</a>
            <span class="muted"> — {x.stack_size}/stack</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <Related
    links={[
      { href: "/production-calculator/", title: "Production Calculator", sub: "Per-minute rates", tool: true },
      { href: "/items/", title: "Items", sub: "All recipes" },
    ]}
  />
</Base>

<style>
  .rank-list { margin: 0; padding-left: 1.3rem; line-height: 1.9; }
  .rank-list img { margin-left: 0.3rem; }
</style>
